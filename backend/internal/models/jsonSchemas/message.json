{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "message.json",
  "title": "Message",
  "description": "A message that is shared between client and server",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "auth",
        "subscribe",
        "unsubscribe",
        "error",
        "broadcast",
        "ping",
        "pong",
        "query",
        "mutation",
        "response"
      ],
      "description": "The message type"
    },
    "payload": {
      "type": "object",
      "description": "Optional payload"
    }
  },
  "required": [
    "type"
  ],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "query"
        },
        "payload": {
          "$ref": "query.json"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "mutation"
        },
        "payload": {
          "$ref": "mutation.json"
        }
      }
    },
    {
      "properties": {
        "type": {
          "enum": [
            "auth",
            "subscribe",
            "unsubscribe",
            "error",
            "broadcast",
            "ping",
            "pong",
            "response"
          ]
        }
      }
    }
  ]
}