{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "message.json",
  "title": "Message",
  "description": "A message that is shared between client and server",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "auth",
        "subscribe",
        "unsubscribe",
        "error",
        "broadcast",
        "ping",
        "pong",
        "query",
        "mutation",
        "response"
      ],
      "description": "The message type"
    },
    "payload": {
      "type": "object",
      "description": "Optional payload"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "query"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "query.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mutation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "mutation.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "ping",
              "pong"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "payload"
          ]
        }
      }
    }
  ]
}