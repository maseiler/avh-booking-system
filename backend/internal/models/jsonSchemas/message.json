{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "message.json",
  "title": "Message",
  "description": "A message that is shared between client and server",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "auth",
        "subscribe",
        "unsubscribe",
        "error",
        "broadcast",
        "ping",
        "pong",
        "query",
        "queryResult",
        "queryResultList",
        "mutation",
        "mutationResult"
      ],
      "description": "The message type"
    },
    "payload": {
      "type": "object",
      "description": "Optional payload"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "error.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "query"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "sql/query.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "sql/queryResultList.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mutation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "sql/mutation.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mutationResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "sql/mutationResult.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ping"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "ping.json"
          }
        },
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "broadcast"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "sql/queryResult.json"
          }
        }
      }
    }
  ]
}