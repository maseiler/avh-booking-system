{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "error.json",
  "title": "Error",
  "description": "An error message",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The error code"
    },
    "message": {
      "type": "string",
      "description": "The error message"
    },
    "details": {
      "type": "string",
      "description": "The error details"
    }
  },
  "required": [
    "code",
    "message"
  ]
}