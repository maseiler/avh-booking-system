{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "account.json",
  "title": "Account",  "description": "An account that that issues bookings",
  "type": "object",
  "properties": {
    "id": {
      "type": "number",
      "description": "The unique ID"
    },
    "firstName": {
      "type": "string",
      "description": "The first name"
    },
    "nickname": {
      "type": "string",
      "description": "The nickname"
    },
    "lastName": {
      "type": "string",
      "description": "The last name"
    },
    "email": {
      "type": "string",
      "description": "The email address"
    },
    "phone": {
      "type": "string",
      "description": "The phone number"
    },
    "balance": {
      "type": "number",
      "description": "The current credit available"
    },
    "maxDebt": {
      "type": "number",
      "description": "The maximum debts for this account"
    },
    "category": {
      "type": "number",
      "description": "The category to which the account belongs"
    },
    "enabled": {
      "type": "boolean",
      "description": "True, if the account is active"
    },
    "createdAt": {
      "type": "string",
      "description": "The date and time the account was created. It expects the ISO 8601 format"
    }
  },
  "required": [
    "firstName",
    "nickname",
    "lastName",
    "email",
    "phone",
    "balance",
    "maxDebt",
    "category"
  ]
}