{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "filter.json",
  "title": "Filter",
  "description": "The WHERE clause of a database operation",
  "type": "object",
  "properties": {
    "column": {
      "type": "string",
      "description": "The column this filter is applied to"
    },
    "operator": {
      "type": "string",
      "description": "The comparison operator",
      "enum": [
        "eq",
        "gt",
        "gte",
        "lt",
        "lte",
        "ne"
      ]
    },
    "value": {
      "type": "string",
      "description": "The target value to match"
    }
  },
  "required": [
    "column",
    "operator",
    "value"
  ]
}