{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mutation.json",
  "title": "Mutation",
  "description": "A message that requests a database mutation, i.e., insert, update, and delete.",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "$ref": "_operations.json",
      "description": "The database operation to execute"
    },
    "table": {
      "$ref": "../db/_tableNames.json",
      "description": "The table name"
    },
    "where": {
      "type": "object",
      "description": "The WHERE clause. Only used for delete"
    },
    "values": {
      "type": "object",
      "description": "The object to be mutated"
    }
  },
  "required": [
    "operation",
    "table"
  ],
  "additionalProperties": false
}