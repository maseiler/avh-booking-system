{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "queryResultList.json",
  "title": "QueryResultList",
  "description": "The result of a database query",
  "type": "object",
  "properties": {
    "table": {
      "$ref": "../db/_tableNames.json",
      "description": "The table name"
    },
    "data": {
      "type": "array",
      "description": "A list of database objects",
      "items": {
        "oneOf": [
          {
            "$ref": "../db/account.json"
          },
          {
            "$ref": "../db/category.json"
          },
          {
            "$ref": "../db/product.json"
          },
          {
            "$ref": "../db/unit.json"
          }
        ]
      }
    }
  },
  "required": [
    "table"
  ],
  "additionalProperties": false
}
