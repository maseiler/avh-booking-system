{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vat.json",
  "title": "VAT",
  "description": "The value-added tax (VAT) of a product",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique ID"
    },
    "rate": {
      "type": "integer",
      "description": "The rate as a percentage"
    }
  },
  "required": [
    "rate"
  ],
  "additionalProperties": false
}